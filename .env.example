# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Places API (New)
# Used for Stage 1 business discovery in UK
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Anthropic API (for Stage 3 & 4 analysis and pitches)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5-5

# UK Companies House API (for Stage 3 official registry checks)
COMPANIES_HOUSE_API_KEY=your-companies-house-api-key

# Apify (for fallback social profile lookups without direct scraping)
APIFY_API_TOKEN=your-apify-token

# Inngest Background Jobs
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

